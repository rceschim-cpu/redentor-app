rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Helpers ───────────────────────────────────────────────────────────
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return request.auth != null && userRole() == 'administrador';
    }
    function isStaff() {
      return request.auth != null && userRole() in ['administrador', 'pastor'];
    }


    // Usuários — qualquer autenticado pode ler; escrita no próprio perfil
    // ou por outro autenticado (para admin alterar role de outros usuários)
    match /users/{uid} {
      allow read, write: if request.auth != null;
    }

    // Membros — leitura para autenticados, escrita para autenticados
    match /members/{id} {
      allow read, write: if request.auth != null;
    }

    // Grupos
    match /groups/{id} {
      allow read, write: if request.auth != null;
    }

    // Memberships (subcoleção de grupos)
    match /groups/{groupId}/memberships/{id} {
      allow read, write: if request.auth != null;
    }

    // Materiais
    match /group_materials/{id} {
      allow read, write: if request.auth != null;
    }

    // Notificações — cada usuário lê/escreve as próprias
    match /notifications/{uid}/items/{id} {
      allow read, write: if request.auth != null;
    }

    // Banners da home
    match /banners/{id} {
      allow read, write: if request.auth != null;
    }

    // Redentor Kids — crianças e presenças
    match /children/{id} {
      allow read, write: if request.auth != null;
    }

    match /children_attendance/{id} {
      allow read, write: if request.auth != null;
    }

    // Ministérios — leitura para autenticados, escrita também
    // (a UI controla quem pode editar; regras finas podem ser adicionadas depois)
    match /ministries/{id} {
      allow read, write: if request.auth != null;

      // Subcoleção: voluntários do ministério
      match /memberships/{memberId} {
        allow read, write: if request.auth != null;
      }

      // Subcoleção: escalas do ministério
      match /schedules/{scheduleId} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Matriz de permissões ──────────────────────────────────────────────
    // Leitura por qualquer autenticado: o app carrega a matriz no boot para
    // saber o que exibir. Escrita apenas por administrador.
    match /config/permissions {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // ── Solicitações de mudança de perfil ─────────────────────────────────
    match /role_requests/{id} {
      // Cada um lê as próprias; pastor e administrador leem todas
      allow read: if request.auth != null
                  && (resource.data.uid == request.auth.uid || isStaff());

      // Só dá para abrir pedido em nome próprio, e sempre como pendente
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pendente';

      // Aprovar ou recusar é exclusivo de pastor e administrador
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── Solicitações de criação de pequeno grupo ──────────────────────────
    match /group_requests/{id} {
      // Cada um lê as próprias; pastor e administrador leem todas
      allow read: if request.auth != null
                  && (resource.data.uid == request.auth.uid || isStaff());

      // Só dá para abrir pedido em nome próprio, e sempre como pendente
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pendente';

      // Aprovar ou recusar é exclusivo de pastor e administrador
      allow update: if isStaff();

      // Quem pediu pode cancelar enquanto está pendente
      allow delete: if isAdmin()
                    || (request.auth != null
                        && resource.data.uid == request.auth.uid
                        && resource.data.status == 'pendente');
    }
  }
}
